NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Whisper transcription + session coaching analysis
OPENAI_API_KEY=

# Parental consent emails (age verification under-13 path)
# No custom domain needed for testing — leave RESEND_FROM_EMAIL blank to use
# Resend’s onboarding address (beth.t@example.com). That sender can usually
# only email the address on your Resend account.
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Haelo <beth.t@example.com>

# Optional overrides
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
