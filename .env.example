NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Whisper transcription + session coaching analysis
OPENAI_API_KEY=

# Transactional email (password reset, parental consent, etc.)
# Password reset uses Resend + Supabase generateLink (not Supabase’s mailer).
RESEND_API_KEY=
# Required to send to anyone other than your Resend account email:
# 1) Verify a domain at https://resend.com/domains (DNS SPF + DKIM)
# 2) Set a from-address on that domain, e.g.:
# RESEND_FROM_EMAIL=Halo <noreply@halo-speak.com>
# Also set your live site URL so reset + parent approve links work:
# NEXT_PUBLIC_SITE_URL=https://www.halo-speak.com

# Optional overrides
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
