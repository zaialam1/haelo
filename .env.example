NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for Whisper transcription + session coaching analysis
OPENAI_API_KEY=

# Parental consent emails (age verification under-13 path)
# Dev/test: leave RESEND_FROM_EMAIL blank. Resend’s onboarding sender
# (beth.t@example.com) works without a custom domain, but can usually only
# deliver to the email on your Resend account.
RESEND_API_KEY=
# Production: buy a domain, add it in Resend → Domains, add the DNS records
# Resend shows (SPF + DKIM), wait until verified, then set:
# RESEND_FROM_EMAIL=Haelo <noreply@yourdomain.com>
# Also set your live site URL so parent approve links work:
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional overrides
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
